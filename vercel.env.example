# ==========================================
# ENVIRONMENT VARIABLES UNTUK VERCEL
# ==========================================
# Panduan: 
# Copy-paste key dan value ini ke menu:
# Vercel Dashboard -> Project -> Settings -> Environment Variables

# ------------------------------------------
# 1. UNTUK PROJECT BACKEND (Node.js/Express)
# ------------------------------------------
# URL koneksi dari Supabase/Neon (berakhiran /postgres atau pgbouncer)
DATABASE_URL="postgresql://postgres.[ID_PROYEK]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Secret acak untuk keamanan login (Minimal 32 Karakter)
# Contoh: gunakan hasil dari web password generator
JWT_SECRET="masukkan_rahasia_acak_disini_jangan_sampai_bocor"

# Optimasi serverless
NODE_ENV="production"


# ------------------------------------------
# 2. UNTUK PROJECT FRONTEND (React/Vite)
# ------------------------------------------
# URL domain backend yang sudah di-deploy di Vercel, ditambah /api
VITE_API_URL="https://[NAMA_PROJECT_BACKEND_KAMU].vercel.app/api"
